{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dimrail",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,

  // 前端产物：pnpm build → dist/client
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/admin", "/admin/*", "/api/*", "/sub/*"]
  },

  // 部署前用 `wrangler d1 create dimrail` 创建并替换 database_id
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dimrail",
      "database_id": "5614b9c0-6e5d-44cf-9f8a-3ba68314bd7b",
      "migrations_dir": "./migrations"
    }
  ],

  "triggers": {
    // 每 6 小时刷新一次启用机场，预热缓存
    "crons": ["0 */6 * * *"]
  },

  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "observability": {
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
