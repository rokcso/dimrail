{
  "name": "dimrail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "predev": "npm run gen",
    "dev": "concurrently -k -n worker,web -c green,blue \"wrangler dev\" \"vite\"",
    "build": "vite build",
    "prebuild": "npm run gen",
    "predeploy": "npm run gen",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "biome check . && npm run typecheck",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply dimrail --local",
    "db:migrate:remote": "wrangler d1 migrations apply dimrail --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@radix-ui/colors": "^3.0.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
